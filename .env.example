# --- Application ---
APP_ENV=development
APP_NAME=Truck Load Analyzer
APP_DEBUG=true

# --- API REST (Bearer token expected by the HTTP layer) ---
API_SECRET=

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# Comma separated numeric Telegram user IDs. Empty means no user is allowed.
TELEGRAM_ALLOWED_USERS=

# --- AI / vision ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=60
MAX_IMAGES_PER_ANALYSIS=6

# --- Market data (Freight Data Watch) ---
MARKET_PROVIDER=freight_datawatch
FREIGHT_DATAWATCH_API_KEY=
FREIGHT_DATAWATCH_BASE_URL=https://app.freightdatawatch.com/api/v1

# --- Weather ---
WEATHER_PROVIDER=nws

# --- Maps and routing ---
MAPS_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=

# --- Persistence ---
DATABASE_URL=sqlite:///./truck_analyzer.db
